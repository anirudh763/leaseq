# Copy this file to .env for local Docker Compose use.
# scripts/up.sh creates random API and app-role credentials when blank or absent,
# preserves existing values, and sets .env permissions to 600. Shell exports take
# precedence over .env. Keep both generated credentials private.
# LEASEQ_POSTGRES_PASSWORD is intentionally not stored here; production mode
# requires it from a protected shell environment or secret manager.
# openssl rand -hex 24
LEASEQ_API_TOKEN=
LEASEQ_APP_PASSWORD=
# The settings below apply to a directly launched API/worker process. The
# default Compose stack forwards the API token and its generated app-role DSN;
# putting other optional keys in .env does not pass them into a
# container. Use an explicit Compose service-environment override when needed.
# LEASEQ_DATABASE_URL=postgresql://leaseq:leaseq@127.0.0.1:5432/leaseq
# LEASEQ_MAX_BODY_BYTES=65536
# LEASEQ_RATE_LIMIT=60000
# LEASEQ_PUBLIC_RATE_LIMIT=120
# LEASEQ_PUBLIC_READ=0
# LEASEQ_BACKOFF_BASE=2
# LEASEQ_BACKOFF_CAP=300
# LEASEQ_COUNTS_MAX_AGE=5
