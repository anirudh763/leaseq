# Copy this file to .env for local Docker Compose use.
# scripts/up.sh creates a random LEASEQ_API_TOKEN when the value is blank or absent,
# preserves an existing token, and sets .env permissions to 600. Shell exports take
# precedence over .env. Keep the generated token private.
# openssl rand -hex 24
LEASEQ_API_TOKEN=
# The settings below apply to a directly launched API/worker process. The
# default docker-compose.yml forwards the token and its own Docker database
# URL only; putting these optional keys in .env does not forward them to a
# container. Use an explicit Compose service-environment override when needed.
# LEASEQ_DATABASE_URL=postgresql://leaseq:leaseq@127.0.0.1:5432/leaseq
# LEASEQ_MAX_BODY_BYTES=65536
# LEASEQ_RATE_LIMIT=60000
# LEASEQ_PUBLIC_RATE_LIMIT=120
# LEASEQ_PUBLIC_READ=0
# LEASEQ_BACKOFF_BASE=2
# LEASEQ_BACKOFF_CAP=300
# LEASEQ_COUNTS_MAX_AGE=5
