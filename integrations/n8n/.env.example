# Optional local n8n configuration for loopback-only development.
# This file uses ordinary dotenv KEY=value syntax. Copy it to .env only for a
# separately installed/local n8n instance. n8n does not auto-load this file;
# provide its values through the existing process/container environment mechanism.
# This repository does not install or start n8n or configure the application.
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_LISTEN_ADDRESS=127.0.0.1
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678/
# Secure cookies are disabled only for loopback HTTP development.
# Use HTTPS and secure cookies for any remote/domain deployment.
N8N_SECURE_COOKIE=false
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_BLOCK_ENV_ACCESS_IN_NODE=true
N8N_BLOCK_FILE_ACCESS_TO_N8N_FILES=true
N8N_DIAGNOSTICS_ENABLED=false
# Let n8n generate and persist its encryption key in its private settings file.
# Back up that key securely; losing/changing it can make stored credentials unreadable.
# Keep API keys in n8n's credential store; do not put them in workflows or $env.
